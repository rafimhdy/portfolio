---
// src/components/Navbar.astro
const { isPage = false } = Astro.props;
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;500;600;700&display=swap');

  .font-inter-nav { font-family: 'Inter', sans-serif !important; }

  /* ── DOCK ── */
  .framer-dock-nav {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: linear-gradient(180deg, rgba(14, 28, 41, 0.5) -53%, rgb(14, 28, 41) 100%);
    border-radius: 100px;
    box-shadow:
      rgba(0,0,0,0.28) 0px 0.706592px 0.706592px -0.583333px,
      rgba(0,0,0,0.27) 0px 1.80656px 1.80656px -1.16667px,
      rgba(0,0,0,0.26) 0px 3.62176px 3.62176px -1.75px,
      rgba(0,0,0,0.24) 0px 6.8656px 6.8656px -2.33333px,
      rgba(0,0,0,0.21) 0px 13.6468px 13.6468px -2.91667px,
      rgba(0,0,0,0.12) 0px 30px 30px -3.5px,
      rgba(255,255,255,0.15) 0px 0px 0px 2px inset;
    z-index: 999 !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 4px !important;
    width: max-content !important;
    padding: 8px 8px 8px 16px !important;
    position: relative;
  }

  /* ── NAV ITEM — desktop: text, mobile: icon only ── */
  .framer-nav-item {
    cursor: pointer;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px;
    padding: 8px 14px !important;
    text-decoration: none !important;
    border-radius: 100px;
    white-space: nowrap !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 15px !important;
    font-weight: 300 !important;
    color: rgb(255,255,255) !important;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .framer-nav-item:hover {
    opacity: 0.7;
  }

  /* Icon inside nav item — hidden on desktop */
  .nav-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: none;  /* hidden desktop */
  }

  /* Label — shown on desktop */
  .nav-label {
    display: inline;
  }

  /* ── HIRE ME BUTTON ── */
  .framer-pill-btn {
    cursor: pointer;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px;
    padding: 8px 20px !important;
    white-space: nowrap !important;
    margin-left: 8px;
    border-radius: 100px !important;
    background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.05) 100%);
    box-shadow: rgba(255,255,255,0.12) 0px 0px 0px 1px inset;
    font-family: 'Inter', sans-serif !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    color: rgb(255,255,255) !important;
    text-decoration: none !important;
    transition: filter 0.2s ease;
    flex-shrink: 0;
  }
  .framer-pill-btn:hover { filter: brightness(1.2); }

  /* Hire icon — hidden desktop */
  .hire-icon { display: none; width: 16px; height: 16px; flex-shrink: 0; }
  .hire-label { display: inline; }

  /* ─────────────────────────────────────
     MOBILE  (≤ 480px)
     Switch to icon-only nav items,
     "Hire Me" keeps its label (short enough).
  ───────────────────────────────────── */
  @media (max-width: 480px) {
    .framer-dock-nav {
      gap: 0px !important;
      padding: 6px 6px 6px 6px !important;
    }

    .framer-nav-item {
      padding: 9px 11px !important;
      font-size: 0 !important;   /* hides text without DOM change */
    }

    /* Show icon, hide label */
    .nav-icon  { display: block; }
    .nav-label { display: none; }

    .framer-pill-btn {
      padding: 9px 16px !important;
      font-size: 13px !important;
      margin-left: 4px;
    }
  }

  /* Midrange (481–640px): slightly tighter text */
  @media (min-width: 481px) and (max-width: 640px) {
    .framer-nav-item {
      padding: 7px 10px !important;
      font-size: 14px !important;
    }
    .framer-dock-nav {
      gap: 2px !important;
      padding: 7px 8px 7px 14px !important;
    }
  }
</style>

<div class="fixed bottom-8 left-1/2 -translate-x-1/2 z-999 antialiased">
  <nav class="framer-dock-nav font-inter-nav">

    { !isPage ? (
      <>
        <a href="/" class="framer-nav-item">
          <!-- Home icon -->
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12L12 4l9 8M5 10v9a1 1 0 001 1h4v-5h4v5h4a1 1 0 001-1v-9"/>
          </svg>
          <span class="nav-label">Home</span>
        </a>
        <a href="#expertise-section" class="framer-nav-item">
          <!-- Expertise / layers icon -->
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          <span class="nav-label">Expertise</span>
        </a>
        <a href="/contact" target="_blank" rel="noopener noreferrer" class="framer-nav-item">
          <!-- Contact / mail icon -->
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 7l10 7 10-7"/>
          </svg>
          <span class="nav-label">Contact</span>
        </a>
      </>
    ) : (
      <>
        <a href="#" class="framer-nav-item">
          <!-- Profile / user icon -->
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
          </svg>
          <span class="nav-label">Profile</span>
        </a>
        <a href="#projects" class="framer-nav-item">
          <!-- Projects / grid icon -->
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
          <span class="nav-label">Projects</span>
        </a>
        <a href="#tools" class="framer-nav-item">
          <!-- Tools / wrench icon -->
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>
          </svg>
          <span class="nav-label">Tools</span>
        </a>
        <a href="/contact" target="_blank" rel="noopener noreferrer" class="framer-nav-item">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 7l10 7 10-7"/>
          </svg>
          <span class="nav-label">Contact</span>
        </a>
      </>
    )}

    <a href="mailto:rafi@quansel.com" class="framer-pill-btn">
      Hire Me
    </a>

  </nav>
</div>