---
// src/components/ExpertisesList.astro
const categories = [
  {
    num: "01",
    slug: "admin",
    title: "Administrative Support",
    desc: "Handling complex data systems, reporting, and task coordination with absolute precision.",
    bgImage: "/admin.webp"
  },
  {
    num: "02",
    slug: "customer-service",
    title: "Customer Service",
    desc: "Handling client inquiries and maintaining high satisfaction operations seamlessly.",
    bgImage: "/cs.webp"
  },
  {
    num: "03",
    slug: "operations",
    title: "Export Import",
    desc: "Managing international supply chains, customs, and global logistics.",
    bgImage: "exim.webp"
  },
  {
    num: "04",
    slug: "design",
    title: "Graphic Design",
    desc: "Crafting visual identities and modular layout systems that leave a mark.",
    bgImage: "design.webp"
  },
  {
    num: "05",
    slug: "creative",
    title: "Creative Content",
    desc: "Producing digital media assets and structured presentation layouts.",
    bgImage: "creative.webp"
  },
  {
    num: "06",
    slug: "tech",
    title: "Information Technology",
    desc: "Developing high-performance applications with headless architecture.",
    bgImage: "/it.webp"
  },
  {
    num: "07",
    slug: "translation",
    title: "Technical Translation",
    desc: "Bridging complex technical documentation and legal contexts accurately.",
    bgImage: "translate.webp"
  },
  {
    num: "08",
    slug: "technical-writing",
    title: "Technical Writing",
    desc: "Transforming complex technical concepts into clear, accurate, and accessible documentation.",
    bgImage: "technical-writing.webp"
  }
];
---

<style>
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/Satoshi-Variable.woff2') format('woff2'),
         url('/fonts/Satoshi-Regular.woff2') format('woff2');
    font-weight: 300 900;
    font-display: swap;
  }

  .font-instrument { font-family: 'Instrument Serif', serif; }
  .font-satoshi    { font-family: 'Satoshi', sans-serif; }

  /* ── WRAPPER ── */
  .stack-section-wrapper {
    background-color: #f8fafc;
    position: relative;
  }

  /* ── DOTS NAV — desktop only ── */
  .scroll-dots-container {
    position: fixed;
    left: 40px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    z-index: 100;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  @media (min-width: 1024px) {
    .stack-section-wrapper.is-in-view .scroll-dots-container {
      opacity: 1;
      visibility: visible;
    }
  }

  .nav-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #cbd5e1;
    transition: background-color 0.3s ease;
    position: relative;
  }
  .nav-dot.active { background-color: #0f172a; }
  .nav-dot.active::after {
    content: '';
    position: absolute;
    top: -8px; left: -8px; right: -8px; bottom: -8px;
    border: 2px solid #0f172a;
    border-radius: 50%;
  }

  /* ── HERO ── */
  .hero-header {
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
  }

  .hero-title {
    font-size: clamp(2.4rem, 7vw, 6rem);
    color: #0f172a;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
    max-width: 800px;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #475569;
    font-weight: 400;
  }

  /* ── STICKY WRAPPER ── */
  .card-sticky-wrapper {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    z-index: var(--card-index);
  }

  /* ── CARD INNER ── */
  .card-inner {
    width: 100%;
    max-width: 1100px;
    height: 85vh;
    background-color: #ffffff;
    border-radius: 28px;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 -10px 40px rgba(15, 23, 42, 0.03);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform-origin: top center;
    will-change: transform, opacity, filter;
  }

  /* ─────────────────────────────────────────
     TOP ROW
  ───────────────────────────────────────── */
  .card-top-row {
    display: flex;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    flex-shrink: 0;
  }

  .card-title-box {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 24px 32px;
    border-right: 1px solid rgba(15, 23, 42, 0.08);
    gap: 16px;
    min-width: 0;
  }

  .card-number {
    font-size: 18px;
    font-weight: 500;
    color: #64748b;
    padding-top: 8px;
    flex-shrink: 0;
  }

  /* ── WADAH TEKS MARQUEE ── */
  .card-title-wrapper {
    flex: 1;
    min-width: 0;
    overflow: hidden; /* Potong teks yang keluar batas */
    display: flex;
    align-items: center;
    transition: mask-image 0.3s ease;
  }

  /* Efek gradasi pudar di ujung teks HANYA aktif jika teksnya overflow */
  .card-title-wrapper.is-overflowing {
    -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
    mask-image: linear-gradient(to right, black 85%, transparent 100%);
  }

  .card-title {
    font-size: clamp(1.8rem, 4.5vw, 5rem);
    font-weight: 300;
    color: #0f172a;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap; /* Jangan pernah turun ke baris baru */
    display: inline-block; /* Diperlukan agar animasi CSS jalan */
    will-change: transform;
  }

  /* Animasi ini bakal ditempel lewat JavaScript */
  .marquee-bounce {
    animation: bounceText 5.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;
  }

  @keyframes bounceText {
    0%, 15% { transform: translateX(0); } /* Tahan sebentar di awal */
    85%, 100% { transform: translateX(var(--overflow-distance)); } /* Tahan sebentar di akhir */
  }

  /* Arrow box */
  .card-arrow-box {
    width: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #475569;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .card-arrow-box:hover {
    background: #f1f5f9;
    color: #0f172a;
  }
  .card-arrow-box svg {
    width: 30px; height: 30px;
    stroke-width: 1.5px;
    transition: transform 0.3s ease;
  }
  .card-arrow-box:hover svg { transform: translate(4px, -4px); }

  /* ─────────────────────────────────────────
     BOTTOM ROW
  ───────────────────────────────────────── */
  .card-bottom-row {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .card-bottom-row { flex-direction: row; }
  }

  /* Desc box */
  .card-desc-box {
    flex: 0 0 auto;
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .card-desc-box {
      flex: 1;
      padding: 36px 48px;
      gap: 36px;
    }
  }

  .card-desc {
    font-size: clamp(15px, 2vw, 22px);
    line-height: 1.55;
    color: #475569;
    font-weight: 400;
  }

  /* Explore button */
  .explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 24px;
    text-decoration: none;
    font-family: 'Satoshi', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #ffffff;
    cursor: pointer;
    transition: transform 0.12s, filter 0.2s;
    transform: translate(2.9px, 0.3px);
    background: linear-gradient(127deg, rgb(14, 28, 41) -68%, rgb(50, 61, 104) 100%);
    border-radius: 10px;
    box-shadow:
      rgb(184, 193, 230) 0px 1px 2px 0px inset,
      rgba(46, 64, 128, 0.35) 0px 0.706592px 0.706592px -0.583333px,
      rgba(46, 64, 128, 0.34) 0px 1.80656px 1.80656px -1.16667px,
      rgba(46, 64, 128, 0.33) 0px 3.62176px 3.62176px -1.75px,
      rgba(46, 64, 128, 0.3) 0px 6.8656px 6.8656px -2.33333px,
      rgba(46, 64, 128, 0.26) 0px 13.6468px 13.6468px -2.91667px,
      rgba(46, 64, 128, 0.15) 0px 30px 30px -3.5px;
  }
  .explore-btn:hover { filter: brightness(1.15); }
  .explore-btn:active {
    transform: translate(2.9px, 2.9px);
    box-shadow:
      rgb(184, 193, 230) 0px 1px 2px 0px inset,
      rgba(46, 64, 128, 0.35) 0px 0.706592px 0.706592px -0.583333px;
  }

  .btn-icon {
    width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
  }

  /* Image box */
  .card-img-box {
    flex: 1;
    min-height: 0;
    padding: 0 16px 16px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .card-img-box {
      padding: 24px 40px 40px 0;
    }
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
    display: block;
  }

  /* ─────────────────────────────────────────
     SMALL PHONE  (< 480px)
  ───────────────────────────────────────── */
  @media (max-width: 479px) {
    .card-sticky-wrapper { padding: 0 10px; }

    .card-inner {
      height: 88vh;
      border-radius: 20px;
    }

    .card-title-box {
      padding: 16px 18px;
      gap: 10px;
      border-right: none;
    }

    .card-top-row { flex-wrap: wrap; }

    .card-arrow-box {
      width: 56px;
      height: 56px;
      border-left: 1px solid rgba(15, 23, 42, 0.08);
    }

    .card-number { font-size: 14px; padding-top: 4px; }

    .card-desc-box { padding: 16px 18px; gap: 16px; }

    .card-img-box { padding: 0 12px 12px; }

    .card-img { border-radius: 10px; }
  }
</style>

<section class="stack-section-wrapper font-satoshi" id="expertise-section">

  <div class="scroll-dots-container" id="dots-nav">
    {categories.map((_, i) => (
      <div class="nav-dot" data-dot-index={i}></div>
    ))}
  </div>

  <div class="hero-header">
    <h1 class="font-instrument hero-title">
      Where most see limits,<br>
      <span class="italic text-slate-500">I envision pathways.</span>
    </h1>
    <p class="hero-subtitle">Connecting visionary minds to rare opportunities is what drives me.</p>
  </div>

  <div class="cards-container">
    {categories.map((cat, index) => (
      <div
        class="card-sticky-wrapper"
        style={`--card-index: ${index}; z-index: ${index};`}
        data-card-index={index}
      >
        <div class="card-inner">
          <div class="card-top-row">
            <div class="card-title-box">
              <span class="card-number">{cat.num}.</span>
              <div class="card-title-wrapper">
                <h2 class="font-satoshi card-title">{cat.title}</h2>
              </div>
            </div>
            <a href={`/${cat.slug}`} class="card-arrow-box" aria-label={`Go to ${cat.title}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <div class="card-bottom-row">
            <div class="card-desc-box">
              <p class="card-desc">{cat.desc}</p>
              <a href={`/${cat.slug}`} class="explore-btn">
                Explore Role
                <div class="btn-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </a>
            </div>
            <div class="card-img-box">
              <img src={cat.bgImage} alt={cat.title} class="card-img" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* --- LOGIKA STICKY SCROLL ASLI --- */
    const sectionWrapper = document.getElementById('expertise-section');
    const wrappers = document.querySelectorAll('.card-sticky-wrapper');
    const dots = document.querySelectorAll('.nav-dot');

    if (sectionWrapper && wrappers.length > 0) {
      const wrapperObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            sectionWrapper.classList.add('is-in-view');
          } else {
            sectionWrapper.classList.remove('is-in-view');
          }
        });
      }, { threshold: 0.1 });
      wrapperObserver.observe(sectionWrapper);

      let ticking = false;

      const handleScroll = () => {
        const windowHeight = window.innerHeight;

        wrappers.forEach((wrapper, index) => {
          const innerCard = wrapper.querySelector('.card-inner') as HTMLElement;
          const rect = wrapper.getBoundingClientRect();

          if (rect.top <= windowHeight * 0.5 && rect.bottom >= windowHeight * 0.5) {
            dots.forEach(d => d.classList.remove('active'));
            const activeDot = document.querySelector(`.nav-dot[data-dot-index="${index}"]`);
            if (activeDot) activeDot.classList.add('active');
          }

          if (!innerCard) return;

          if (index === wrappers.length - 1) {
            innerCard.style.opacity = '1';
            innerCard.style.transform = 'scale(1) translateY(0)';
            innerCard.style.filter = 'blur(0)';
            return;
          }

          const nextWrapper = wrappers[index + 1];
          const nextRect = nextWrapper.getBoundingClientRect();
          const distanceToCover = nextRect.top;

          if (distanceToCover <= 0) {
            innerCard.style.opacity = '0';
            innerCard.style.transform = 'scale(0.8) translateY(-40px)';
            innerCard.style.filter = 'blur(10px)';
          } else if (distanceToCover < windowHeight) {
            let rawProgress = 1 - (distanceToCover / windowHeight);
            let easeProgress = rawProgress * rawProgress;

            let opacity = Math.max(0, 1 - (easeProgress * 2));
            let scale = 1 - (easeProgress * 0.15);
            let yOffset = easeProgress * -40;
            let blurAmount = easeProgress * 10;

            innerCard.style.opacity = opacity.toString();
            innerCard.style.transform = `scale(${scale}) translateY(${yOffset}px)`;
            innerCard.style.filter = `blur(${blurAmount}px)`;
          } else {
            innerCard.style.opacity = '1';
            innerCard.style.transform = 'scale(1) translateY(0)';
            innerCard.style.filter = 'blur(0)';
          }
        });
        ticking = false;
      };

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      });

      handleScroll();
    }

    /* --- LOGIKA TEKS MARQUEE / BOUNCE BARU --- */
    const initMarquees = () => {
      document.querySelectorAll('.card-title-wrapper').forEach(wrapper => {
        const title = wrapper.querySelector('.card-title') as HTMLElement;
        if (!title) return;

        // Reset kelas animasi biar bisa ngukur ulang dengan akurat
        wrapper.classList.remove('is-overflowing');
        title.classList.remove('marquee-bounce');
        title.style.transform = '';

        // Hitung apakah teks lebih panjang dari ruang yang tersedia
        const overflow = title.scrollWidth - wrapper.clientWidth;

        // Cuma dianimasiin kalau emang beneran kepotong / mentok
        if (overflow > 2) {
          wrapper.classList.add('is-overflowing'); // Memicu gradasi pinggiran
          title.style.setProperty('--overflow-distance', `-${overflow}px`);
          title.classList.add('marquee-bounce'); // Memicu animasi jalan
        }
      });
    };

    // Jalankan kalkulasi saat halaman selesai dimuat
    // Timeout kecil memastikan font sudah terender ukurannya
    setTimeout(initMarquees, 100);

    // Hitung ulang kalau user bolak-balik hp (portrait ke landscape)
    window.addEventListener('resize', () => {
      window.requestAnimationFrame(initMarquees);
    });
  });
</script>