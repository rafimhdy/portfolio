---
// src/components/Preloader.astro
---

<div id="pl" aria-hidden="true" role="status">

  <!-- Top: meta bar -->
  <div class="pl-top">
    <span class="pl-cap">Portfolio</span>
    <span class="pl-cap">Muhammad Rafi Mahdy</span>
  </div>

  <!-- Center: counter MASSIVE -->
  <div class="pl-mid">
    <div class="pl-num-clip">
      <span class="pl-num" id="pl-num">0</span>
    </div>
  </div>

  <!-- Bottom: progress + name -->
  <div class="pl-bot">
    <div class="pl-track">
      <div class="pl-fill" id="pl-fill"></div>
    </div>
    <div class="pl-bot-row">
      <span class="pl-serif">Muhammad Rafi Mahdy.</span>
      <span class="pl-cap">Bandung, ID</span>
    </div>
  </div>

</div>

<style is:global>
  /* ── ROOT ─────────────────────────────────────────────────────────── */
  #pl {
    position: fixed;
    inset: 0;
    z-index: 99999999;
    background: #07090f;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 4vw, 56px);
    overflow: hidden;

    /*
      clip-path state AWAL didefinisikan di sini (bukan di exit class),
      supaya browser punya referensi untuk menganimasikan transisinya.
    */
    clip-path: inset(0% 0% 0% 0%);
    transition: clip-path 0.9s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: clip-path;
  }

  /* Wipe ke atas: inset dari atas grows to 100% → preloader hilang ke atas */
  #pl.pl-exit {
    clip-path: inset(100% 0% 0% 0%);
    pointer-events: none;
  }

  #pl.pl-gone {
    display: none !important;
  }

  /* ── INNER FADE sebelum exit ─────────────────────────────────────── */
  .pl-top,
  .pl-mid,
  .pl-bot {
    transition: opacity 0.32s ease, transform 0.32s ease;
    will-change: opacity, transform;
  }

  #pl.pl-fading .pl-top,
  #pl.pl-fading .pl-mid,
  #pl.pl-fading .pl-bot {
    opacity: 0;
    transform: translateY(-10px);
  }

  /* ── TOP META BAR ────────────────────────────────────────────────── */
  .pl-top {
    display: flex;
    justify-content: space-between;
    align-items: center;

    /* Enter animation */
    animation: pl-fade-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .pl-cap {
    font-family: 'Inter', sans-serif;
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.18);
  }

  /* ── CENTER: HUGE COUNTER ────────────────────────────────────────── */
  .pl-mid {
    flex: 1;
    display: flex;
    align-items: center;
    /*
      Sedikit geser ke kiri — asimetri editorial khas Awwwards.
      Tidak dead center, memberi kesan desain lebih intentional.
    */
    justify-content: flex-start;
    padding-left: clamp(0px, 1vw, 20px);
  }

  /*
    Clip untuk enter animation: angka muncul dari bawah
    Parent overflow:hidden, child translateY(100%) → 0
  */
  .pl-num-clip {
    overflow: hidden;
    line-height: 0.85;
  }

  .pl-num {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-size: clamp(110px, 20vw, 260px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.85;

    /*
      Gradient text: mulai agak redup (saat angka 0),
      menjadi warm white penuh saat mendekati 100.
      Gradient stop diupdate via JS.
    */
    background: linear-gradient(
      to bottom,
      rgba(230, 225, 213, 0.55) 0%,
      rgba(230, 225, 213, 1) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;

    /* Enter animation: muncul dari bawah */
    animation: pl-num-enter 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: transform, opacity;
  }

  /* ── BOTTOM ──────────────────────────────────────────────────────── */
  .pl-bot {
    display: flex;
    flex-direction: column;
    gap: 12px;

    animation: pl-fade-up 0.6s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Progress track: 1px tipis, warna sangat muted */
  .pl-track {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.07);
    position: relative;
    overflow: hidden;
  }

  /* Fill: scaleX dari 0 → 1, dianimasikan via transition */
  .pl-fill {
    position: absolute;
    inset: 0;
    background: rgba(230, 225, 213, 0.5);
    transform-origin: left;
    transform: scaleX(0);

    /*
      Durasi sama dengan COUNT_MS di JS — keduanya bergerak sinkron.
      Easing: cubic-bezier(0.25, 1, 0.5, 1) = ease-out — terasa natural.
    */
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .pl-fill.is-on {
    transform: scaleX(1);
  }

  .pl-bot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pl-serif {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(13px, 1.6vw, 18px);
    color: rgba(230, 225, 213, 0.3);
    letter-spacing: -0.01em;
  }

  /* ── ENTER KEYFRAMES ─────────────────────────────────────────────── */
  @keyframes pl-num-enter {
    from {
      transform: translateY(55%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes pl-fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
(function () {
  /* ── Config ─────────────────────────────────────────────────────── */
  var KEY      = 'rafi-pl-v1'; /* ganti key ini untuk reset session    */
  var COUNT_MS = 1500;         /* durasi counter 0 → 100              */
  var PAUSE_MS = 240;          /* jeda setelah angka 100 sebelum fade  */
  var FADE_MS  = 320;          /* durasi fade inner sebelum wipe       */
  var WIPE_MS  = 920;          /* durasi clip-path wipe (= transition) */
  var FALLBACK = 7000;         /* hard kill — preloader tidak stuck     */

  /* ── Elements ───────────────────────────────────────────────────── */
  var root   = document.getElementById('pl');
  var numEl  = document.getElementById('pl-num');
  var fillEl = document.getElementById('pl-fill');
  if (!root || !numEl || !fillEl) return;

  /* ── Dismiss helpers ─────────────────────────────────────────────── */
  function killNow() {
    root.classList.add('pl-gone');
  }

  function dismissAnimated() {
    /* Step 1: fade inner content ke atas */
    root.classList.add('pl-fading');

    setTimeout(function () {
      /* Step 2: clip-path wipe — preloader hilang ke atas */
      root.classList.add('pl-exit');

      /* Step 3: setelah wipe selesai, display:none */
      setTimeout(killNow, WIPE_MS + 80);
    }, FADE_MS);
  }

  /* ── Session check: skip preloader kalau sudah pernah tampil ────── */
  try {
    if (sessionStorage.getItem(KEY)) {
      killNow();
      return;
    }
    sessionStorage.setItem(KEY, '1');
  } catch (e) { /* private/incognito mode — lanjutkan normal */ }

  /* ── Hard fallback ───────────────────────────────────────────────── */
  setTimeout(function () {
    if (!root.classList.contains('pl-gone')) killNow();
  }, FALLBACK);

  /* ── Progress bar: trigger setelah browser render frame awal ─────── */
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      fillEl.classList.add('is-on');
    });
  });

  /* ── Counter animation ───────────────────────────────────────────── */
  /*
    Easing: ease-in-out cubic.
    Mulai lambat → akselerasi di tengah → perlahan di akhir.
    Ini yang bikin angka terasa 'berat' dan 'loading' yang riil,
    bukan sekedar linear increment.
  */
  function easeInOut(t) {
    return t < 0.5
      ? 4 * t * t * t
      : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  var startTs = null;

  function tick(ts) {
    if (!startTs) startTs = ts;
    var elapsed = ts - startTs;
    var raw     = Math.min(elapsed / COUNT_MS, 1);
    var eased   = easeInOut(raw);
    var val     = Math.round(eased * 100);

    numEl.textContent = val;

    /*
      Gradient brightness mengikuti progress:
      saat angka kecil → agak redup (top stop lebih gelap).
      saat mendekati 100 → penuh terang.
      Ini bikin angka terasa 'revealing' seiring loading.
    */
    var topOpacity = (0.35 + eased * 0.65).toFixed(2);
    numEl.style.backgroundImage =
      'linear-gradient(to bottom, rgba(230,225,213,' + topOpacity + ') 0%, rgba(230,225,213,1) 100%)';

    if (raw < 1) {
      requestAnimationFrame(tick);
    } else {
      /* Counter selesai: pause sebentar lalu dismiss */
      setTimeout(dismissAnimated, PAUSE_MS);
    }
  }

  /* Tunggu animasi enter (.pl-num-enter = 0.85s) selesai baru mulai counter */
  setTimeout(function () {
    requestAnimationFrame(tick);
  }, 300); /* Mulai agak setelah render awal — entry terasa lebih dramatic */

})();
</script>