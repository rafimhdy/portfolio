---
// src/components/Preloader.astro
---

<div id="framer-preloader" class="preloader-wrapper">
  <div class="overflow-hidden">
    <h1 class="instrument-splash text-white text-7xl md:text-9xl tracking-tight animate-reveal opacity-0">
      Rafi Mahdy.
    </h1>
  </div>
  <div class="overflow-hidden mt-3">
    <p class="text-slate-400 font-mono tracking-widest text-[10px] md:text-xs uppercase animate-reveal opacity-0" style="animation-delay: 0.2s;">
      Loading Experience
    </p>
  </div>
</div>

<style is:global>
  /* PRELOADER STYLES */
  .preloader-wrapper {
    position: fixed; inset: 0; z-index: 99999999;
    background-color: #020617; 
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    width: 100%; height: 100dvh;
    /* PENTING: Transisi ditaruh di sini biar browser tau cara nganimasiinnya */
    transition: transform 0.8s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .instrument-splash { font-family: 'Instrument Serif', serif; }

  @keyframes revealText {
    0% { transform: translateY(100%); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  
  .animate-reveal { animation: revealText 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  
  .splash-exit {
    transform: translateY(-100%);
    pointer-events: none; 
  }
</style>

<script is:inline>
  // Dibungkus function biar gak tabrakan sama script lain (IIFE)
  (function() {
    function hilangkanPreloader() {
      const loader = document.getElementById('framer-preloader');
      if (!loader) return; // Kalau gak ketemu, batalin biar gak error
      
      setTimeout(() => {
        loader.classList.add('splash-exit');
        
        // Hapus total dari layar setelah animasi beres
        setTimeout(() => { 
          loader.style.display = 'none'; 
        }, 800); 
      }, 1800);
    }

    // Trik Jitu: Pastikan DOM beneran udah jadi sebelum nyari elemen
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', hilangkanPreloader);
    } else {
      hilangkanPreloader();
    }
  })();
</script>