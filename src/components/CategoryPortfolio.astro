---
// src/components/CategoryPortfolio.astro
import React from 'react';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sanityClient } from "sanity:client";
import { PortableText } from '@portabletext/react';
import { createImageUrlBuilder } from '@sanity/image-url';
import Navbar from './Navbar.astro';

const { slug, title, summary } = Astro.props;

const builder = createImageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

// Komponen penjinak gambar (Fix: Murni menggunakan properti HTML 'class', bukan 'className')
const portableTextComponents = {
  types: {
    inlineImage: ({ value }) => {
      if (!value?.asset?._ref) return null;

      const customWidth = value.width || '100%';
      const customHeight = value.height || 'auto';

      let imageBuilder = urlFor(value).auto('format');

      if (value.width && !value.width.includes('%') && !value.width.includes('px')) {
        imageBuilder = imageBuilder.width(parseInt(value.width));
      }
      if (value.height && !value.height.includes('%') && !value.height.includes('px')) {
        imageBuilder = imageBuilder.height(parseInt(value.height));
      }

      const imageUrl = imageBuilder.url();

      return React.createElement(
        'div',
        { class: 'w-full my-6 flex justify-center' },
        React.createElement('img', {
          src: imageUrl,
          alt: value.alt || 'Project Screenshot',
          class: 'rounded-2xl border border-slate-800 shadow-xl block max-w-full',
          style: {
            width: customWidth,
            height: customHeight,
            objectFit: 'cover',
          },
        })
      );
    },
  },
};

function formatDate(value) {
  if (!value) return '';
  const parsedDate = new Date(value);
  if (Number.isNaN(parsedDate.getTime())) return value;

  return new Intl.DateTimeFormat('id-ID', {
    month: 'short',
    year: 'numeric',
  }).format(parsedDate);
}

function formatRange(experience) {
  const start = formatDate(experience.startDate);
  const end = experience.currentJob ? 'Present' : formatDate(experience.endDate);

  if (start && end) return `${start} - ${end}`;
  return start || end || '';
}

// Tarik data dengan parameter dinamis kustom $slug
const projectQuery = `*[_type == "project" && category == $slug] | order(_createdAt desc) {
  _id,
  title,
  company,
  location,
  coverImage,
  content
}`;

const experienceQuery = `*[_type == "experience" && category == $slug] | order(startDate desc) {
  _id,
  role,
  company,
  companyLogo,
  location,
  startDate,
  endDate,
  currentJob,
  description
}`;

const toolQuery = `*[_type == "tool" && category == $slug] | order(name asc) {
  _id,
  name,
  logo,
  proficiency
}`;

const [projects, experiences, tools] = await Promise.all([
  sanityClient.fetch(projectQuery, { slug }),
  sanityClient.fetch(experienceQuery, { slug }),
  sanityClient.fetch(toolQuery, { slug }),
]);
---

<BaseLayout title={title}>
  <style slot="head">
    /* Styling custom konten ketikan ala Word */
    .word-content p { margin-bottom: 0.85rem; line-height: 1.6; text-align: justify; }
    .word-content ul { list-style-type: disc; margin-left: 1.5rem; margin-bottom: 0.85rem; }
    .word-content ol { list-style-type: decimal; margin-left: 1.5rem; margin-bottom: 0.85rem; }
    .word-content h1 { font-size: 2rem; font-weight: bold; margin-top: 1.5rem; margin-bottom: 0.5rem; color: #fff; }
    .word-content h2 { font-size: 1.5rem; font-weight: bold; margin-top: 1.25rem; margin-bottom: 0.5rem; color: #38bdf8; }
    .word-content h3 { font-size: 1.25rem; font-weight: bold; margin-top: 1.1rem; margin-bottom: 0.4rem; color: #e2e8f0; }
    .word-content strong { font-weight: bold; color: #fff; }
    .word-content a { color: #38bdf8; text-decoration: underline; }
    .word-content blockquote { border-left: 4px solid #38bdf8; padding-left: 1rem; color: #94a3b8; margin: 1rem 0; font-style: italic; }

    dialog::backdrop {
      background-color: rgba(2, 6, 23, 0.9);
      transition: all 0.3s ease-in-out;
    }

    dialog {
      border: none !important;
      outline: none !important;
      padding: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      opacity: 0;
      transform: scale(0.98);
      transition: opacity 0.25s ease-out, transform 0.25s ease-out, display 0.25s allow-discrete;
    }

    dialog[open] {
      opacity: 1;
      transform: scale(1);
    }
  </style>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <a href="/" class="text-sm text-slate-500 hover:text-sky-400 transition inline-block mb-6">← Back to Hub</a>

    <header class="mb-12 border-b border-slate-800 pb-10">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">{title}</h1>
      <div class="mt-5 p-5 bg-slate-900/60 border border-slate-800 rounded-2xl text-base text-slate-300 leading-relaxed max-w-4xl">
        <p>{summary}</p>
      </div>
    </header>

    <section class="mb-14">
      <h2 class="text-xl md:text-2xl font-bold text-slate-200 mb-6">Tools & Technologies</h2>
      
      {tools.length > 0 ? (
        /* Kunci Rahasia Swipe HP Lancar: flex-none, overflow-x-auto, snap-x */
        <div class="flex gap-4 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-slate-800 scrollbar-track-transparent snap-x snap-mandatory">
          {tools.map((tool) => (
            <div class="flex-none w-36 bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col items-center justify-center gap-2 snap-center hover:border-sky-500 transition shadow-lg">
              {tool.logo ? (
                <img
                  src={urlFor(tool.logo).width(120).height(120).fit('crop').auto('format').url()}
                  alt={tool.name}
                  class="w-12 h-12 object-contain"
                />
              ) : (
                <div class="w-12 h-12 bg-slate-950 rounded-xl flex items-center justify-center text-slate-600 text-xs">🛠️</div>
              )}
              <span class="text-white font-bold text-xs text-center truncate w-full mt-1">{tool.name}</span>
              <span class="text-[10px] text-sky-400 uppercase tracking-wider font-semibold capitalize">{tool.proficiency || 'Basic'}</span>
            </div>
          ))}
        </div>
      ) : (
        <div class="p-6 bg-slate-900/40 border border-dashed border-slate-800 rounded-2xl text-center text-sm text-slate-400">
          Belum ada tools di kategori ini.
        </div>
      )}
    </section>

    <section class="mb-14">
      <h2 class="text-xl md:text-2xl font-bold text-slate-200 mb-8">Featured Projects</h2>

      {projects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {projects.map((project) => (
            <div class="group bg-slate-900 rounded-3xl overflow-hidden border border-slate-800 hover:border-sky-500 transition-all flex flex-col justify-between shadow-2xl">
              <div>
                {project.coverImage ? (
                  <div class="aspect-square overflow-hidden border-b border-slate-800 bg-transparent">
                    <img
                      src={urlFor(project.coverImage).width(800).height(800).fit('crop').auto('format').url()}
                      alt={project.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-700 block"
                    />
                  </div>
                ) : (
                  <div class="aspect-square bg-slate-950 flex items-center justify-center border-b border-slate-800 text-slate-700 text-sm">
                    No preview image
                  </div>
                )}

                <div class="p-8">
                  <h3 class="text-2xl font-bold text-white group-hover:text-sky-400 transition">{project.title}</h3>
                  <p class="text-slate-400 text-sm mt-1.5 font-semibold">{project.company || 'Independent Project'}</p>
                </div>
              </div>

              <div class="px-8 pb-8">
                <button
                  onclick={`document.getElementById('modal-${project._id}').showModal()`}
                  class="w-full text-center bg-slate-800 hover:bg-sky-600 hover:text-white text-slate-300 text-sm font-bold py-3 px-6 rounded-2xl transition cursor-pointer"
                >
                  VIEW CASE STUDY →
                </button>
              </div>

              <dialog id={`modal-${project._id}`} class="fixed top-[2vh] left-[2vw] w-[96vw] h-[96vh] max-w-none max-h-none m-0 overflow-hidden shadow-3xl rounded-3xl">
                <div class="bg-slate-900 text-slate-100 w-full h-full border border-slate-800 rounded-3xl flex flex-col overflow-hidden">
                  <button
                    onclick={`this.closest('dialog').close()`}
                    class="absolute top-6 right-6 md:top-8 md:right-8 text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-700 w-11 h-11 rounded-full flex items-center justify-center transition font-bold cursor-pointer z-50 shadow-md"
                  >
                    ✕
                  </button>

                  <div class="flex-1 overflow-y-auto p-8 md:p-16 lg:p-20">
                    <span class="text-sm font-bold uppercase tracking-wider text-sky-400">{project.location || 'Remote'}</span>
                    <h2 class="text-4xl md:text-5xl font-extrabold text-white mt-2 mb-3 tracking-tight">{project.title}</h2>
                    <p class="text-lg text-slate-400 border-b border-slate-800 pb-6 mb-10">{project.company || 'Independent Project'}</p>

                    <div class="word-content text-slate-300 text-base md:text-lg leading-relaxed max-w-6xl mx-auto">
                      {project.content ? (
                        <PortableText value={project.content} components={portableTextComponents} />
                      ) : (
                        <p class="text-slate-500 italic">Belum ada deskripsi detail untuk proyek ini.</p>
                      )}
                    </div>
                  </div>
                </div>
              </dialog>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-slate-900/40 border border-dashed border-slate-800 rounded-3xl">
          <p class="text-slate-400 text-sm">Belum ada proyek di kategori ini.</p>
        </div>
      )}
    </section>

    <section class="mb-14">
      <h2 class="text-xl md:text-2xl font-bold text-slate-200 mb-8">Professional Experience</h2>

      {experiences.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {experiences.map((experience) => (
            <article class="bg-slate-900/70 border border-slate-800 rounded-3xl p-6 md:p-8 flex flex-col justify-between shadow-lg">
              <div class="flex items-start gap-4">
                {experience.companyLogo ? (
                  <img
                    src={urlFor(experience.companyLogo).width(72).height(72).fit('crop').auto('format').url()}
                    alt={experience.company || experience.role}
                    class="w-14 h-14 rounded-2xl object-cover border border-slate-800 bg-slate-950 shrink-0 shadow-md"
                  />
                ) : (
                  <div class="w-14 h-14 rounded-2xl border border-slate-800 bg-slate-950 flex items-center justify-center text-slate-600 shrink-0 text-xl shadow-md">💼</div>
                )}

                <div class="min-w-0 flex-1">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
                    <div>
                      <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">{experience.role}</h3>
                      <p class="text-slate-400 text-sm font-semibold mt-0.5">{experience.company || 'Independent'}</p>
                    </div>
                    <span class="text-xs md:text-sm font-bold text-sky-400 shrink-0 bg-sky-950/40 px-3 py-1 rounded-full border border-sky-900/50 block w-max mt-1 sm:mt-0">
                      {formatRange(experience)}
                    </span>
                  </div>

                  {experience.location && (
                    <p class="text-slate-500 text-xs font-semibold mt-2 inline-flex items-center gap-1">
                      📍 {experience.location}
                    </p>
                  )}

                  <div class="word-content text-slate-300 text-sm md:text-base leading-relaxed mt-5 border-t border-slate-800/60 pt-4">
                    {experience.description ? (
                      <PortableText value={experience.description} components={portableTextComponents} />
                    ) : (
                      <p class="text-slate-500 italic">Belum ada detail deskripsi untuk posisi kerja ini.</p>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-slate-900/40 border border-dashed border-slate-800 rounded-3xl">
          <p class="text-slate-400 text-sm">Belum ada riwayat pengalaman kerja di kategori ini.</p>
        </div>
      )}
    </section>
  </div>

  <script slot="scripts">
    // Script menutup pop-up ketika background dialog di luar kotak diklik
    document.querySelectorAll('dialog').forEach((dialog) => {
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });
    });
  </script>
  <Navbar isPage={true} />
</BaseLayout>