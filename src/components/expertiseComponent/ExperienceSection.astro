---
import { sanityClient } from 'sanity:client';
import { createImageUrlBuilder } from '@sanity/image-url';

interface ExperienceItem {
  _id?: string;
  role: string;
  company: string;
  companyLogo?: any;
  location?: string;
  startDate?: string;
  endDate?: string;
  currentJob?: boolean;
  description?: any[];
}

interface Props {
  experiences: ExperienceItem[];
  slug: string;
}

const { experiences = [], slug } = Astro.props;

const builder = createImageUrlBuilder(sanityClient);

function urlFor(source: any) {
  return builder.image(source);
}

function formatYear(dateString: string | null | undefined) {
  if (!dateString) return 'Present';
  return new Date(dateString).getFullYear().toString();
}

function getDescriptionText(blocks: any[]) {
  if (!blocks?.length) return '';
  return blocks
    .flatMap((block: any) => block.children?.map((child: any) => child.text) ?? [])
    .join(' ')
    .trim();
}

function getRangeLabel(exp: ExperienceItem) {
  const start = formatYear(exp.startDate);
  const end = exp.currentJob ? 'Present' : exp.endDate ? formatYear(exp.endDate) : '';

  if (start && end) return `${start} - ${end}`;
  return start || end || '';
}
---

<style>
  /* Kunci Font Satoshi */
  .font-satoshi { font-family: 'Satoshi', sans-serif; }

  .experience-panel {
    width: 100%;
    margin-top: 40px;
    display: flex;
    flex-direction: column;
  }

  .experience-header {
    margin-bottom: 32px;
    text-align: left;
  }

  .experience-title {
    font-size: 48px;
    font-family: 'Instrument Serif', serif;
    color: #0f172a;
    line-height: 1;
  }

  .experience-list-container {
    display: flex;
    flex-direction: column;
    gap: 16px; /* Jarak antar list */
  }

  /* ── CSS GLASSMORPHISM ── */
  .glass-list-item {
    width: 100%;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(255, 255, 255, 0.1),
      inset 0 0 20px 10px rgba(255, 255, 255, 1);
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-list-item::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.8), transparent);
    z-index: 1; pointer-events: none;
  }
  .glass-list-item::after {
    content: ''; position: absolute; top: 0; left: 0; width: 1px; height: 100%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), transparent, rgba(255, 255, 255, 0.3));
    z-index: 1; pointer-events: none;
  }

  .glass-list-item:hover {
    background: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  /* ── AREA TOMBOL / HEADER LIST (Pake Grid) ── */
  .experience-btn {
    width: 100%;
    background: transparent;
    border: none;
    padding: 20px 24px;
    display: grid;
    grid-template-columns: auto 1fr auto auto; /* 4 Kolom: Logo, Teks, Tahun, Panah */
    align-items: center;
    gap: 24px;
    cursor: pointer;
    position: relative;
    z-index: 2;
    text-align: left;
  }

  /* Logo Kotak Kiri */
  .exp-logo-box {
    width: 56px; height: 56px; border-radius: 14px;
    background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .exp-logo-box img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
  .exp-fallback { font-size: 20px; font-weight: bold; color: #cbd5e1; }

  /* Teks Tengah */
  .exp-text-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .exp-role {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }
  .exp-company {
    font-size: 14px;
    font-weight: 500;
    color: #64748b;
  }

  /* Label Tahun */
  .exp-year {
    font-size: 14px;
    font-weight: 600;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.5);
    padding: 6px 12px;
    border-radius: 100px;
    white-space: nowrap;
  }

  /* Icon Panah */
  .exp-chevron {
    width: 24px; height: 24px; color: #94a3b8;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ── EFEK ACCORDION MELAR ── */
  .experience-body {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    position: relative;
    z-index: 2;
    transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .experience-inner-content { padding: 0 24px 24px 104px; }

  .exp-location {
    font-size: 13px; font-weight: 600; color: #64748b;
    margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em;
  }

  .exp-description {
    font-size: 15px; line-height: 1.6; color: #334155;
  }

  /* ── STATE SAAT DIBUKA ── */
  .glass-list-item.is-open {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }
  .glass-list-item.is-open .experience-body { max-height: 800px; opacity: 1; }
  .glass-list-item.is-open .exp-chevron { transform: rotate(180deg); color: #0f172a; }

  .empty-state { text-align: center; padding: 40px; color: #64748b; }

  /* MOBILE RESPONSIVE LAYOUT MAGIC */
  @media (max-width: 640px) {
    .experience-btn {
      padding: 16px;
      gap: 8px 12px;
      grid-template-columns: auto 1fr auto; /* 3 Kolom buat HP */
    }
    
    .exp-logo-box {
      width: 46px; height: 46px;
      grid-column: 1;
      grid-row: 1 / 3; /* Logo memakan 2 baris */
      align-self: start;
    }
    
    .exp-text-content {
      grid-column: 2;
      grid-row: 1;
    }
    .exp-role { font-size: 16px; }
    
    .exp-year {
      grid-column: 2;
      grid-row: 2; /* Turun ke baris bawah */
      justify-self: start;
      font-size: 11.5px;
      padding: 4px 8px;
    }
    
    .exp-chevron {
      grid-column: 3;
      grid-row: 1 / 3;
      align-self: center;
    }
    
    .experience-inner-content { padding: 0 16px 20px 16px; } 
  }
</style>

<section class="experience-panel font-satoshi">
  <div class="experience-header">
    <h2 class="experience-title">Experience</h2>
  </div>

  {experiences.length > 0 ? (
    <div class="experience-list-container">
      {experiences.map((exp: ExperienceItem, index: number) => {
        const experienceId = exp._id || `${slug}-${index}`;
        
        return (
          <article class="glass-list-item" data-experience-item>
            <button class="experience-btn" data-experience-toggle aria-expanded="false">
              
              <div class="exp-logo-box">
                {exp.companyLogo ? (
                  <img src={urlFor(exp.companyLogo).width(120).url()} alt={exp.company} loading="lazy" />
                ) : (
                  <span class="exp-fallback">◌</span>
                )}
              </div>

              <div class="exp-text-content">
                <div class="exp-role">{exp.role}</div>
                <div class="exp-company">{exp.company}</div>
              </div>

              <div class="exp-year">{getRangeLabel(exp)}</div>
              
              <svg class="exp-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>

            </button>

            <div class="experience-body" aria-hidden="true">
              <div class="experience-inner-content">
                {exp.location && <div class="exp-location">{exp.location}</div>}
                <div class="exp-description">
                  {exp.description ? getDescriptionText(exp.description) : "Detail deskripsi belum tersedia."}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="empty-state font-satoshi">No experiences added yet.</p>
  )}
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('[data-experience-toggle]');

    toggleButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        const item = button.closest('[data-experience-item]');
        if (!item) return;

        const isOpen = item.classList.contains('is-open');

        // Opsional: Tutup item lain yang lagi kebuka (Accordion Style)
        document.querySelectorAll('[data-experience-item].is-open').forEach(openItem => {
          if (openItem !== item) {
            openItem.classList.remove('is-open');
            openItem.querySelector('[data-experience-toggle]')?.setAttribute('aria-expanded', 'false');
          }
        });

        // Toggle item yang diklik
        if (isOpen) {
          item.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>