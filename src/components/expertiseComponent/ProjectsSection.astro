---
import { sanityClient } from 'sanity:client';
import imageUrlBuilder from '@sanity/image-url';

interface Props {
  category: string;
}

const { category } = Astro.props;

const builder = imageUrlBuilder(sanityClient);
function urlFor(source: any) {
  return builder.image(source);
}

const projects = await sanityClient.fetch(
  `*[_type == "project" && category == $category] | order(coalesce(featured, false) desc, _createdAt desc) {
    _id,
    slug,
    title,
    company,
    location,
    coverImage,
    featured
  }`,
  { category }
);
---

<style>
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/Satoshi-Variable.woff2') format('woff2'),
         url('/fonts/Satoshi-Regular.woff2') format('woff2'),
         url('/fonts/Satoshi-Regular.woff') format('woff');
    font-weight: 300 900;
    font-display: swap;
  }

  .projects-section {
    width: 100%;
    padding: 100px 0 120px;
  }

  /* ── HEADER ── */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    max-width: 1280px;
    margin: 0 auto 64px;
    padding: 0 6vw;
  }

  .head-eyebrow {
    font-family: 'Satoshi', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9ca3af;
    margin: 0 0 16px;
  }

  .section-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(48px, 5.5vw, 80px);
    font-weight: 400;
    font-style: italic;
    color: #0d0d0d;
    line-height: 1.0;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .head-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    padding-bottom: 6px;
  }

  .section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #6b7280;
    line-height: 1.7;
    max-width: 320px;
    text-align: right;
    margin: 0;
  }

  .nav-arrows {
    display: flex;
    gap: 10px;
  }

  .nav-arrow {
    background: none;
    border: 1px solid #d1d5db;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    color: #0d0d0d;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .nav-arrow:hover {
    background: #0d0d0d;
    border-color: #0d0d0d;
    color: #fff;
  }

  /* ── SLIDER ── */
  .slider-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 6vw 40px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .slider-track::-webkit-scrollbar { display: none; }

  /* ── CARD — now an <a> tag ── */
  .slide-item {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: 300px;
    height: 420px;
    border-radius: 18px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: #111;
    text-decoration: none;
    display: block;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.35s ease;
  }
  .slide-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.14);
  }

  .card-img-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }
  .slide-item:hover .card-img-bg {
    transform: scale(1.04);
  }

  .card-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5,5,5,0.90) 0%,
      rgba(5,5,5,0.28) 48%,
      rgba(5,5,5,0.06) 100%
    );
  }

  .card-top {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
  }
  .card-badge {
    font-family: 'Satoshi', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 5px 12px;
    border-radius: 100px;
  }

  .card-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 2;
    padding: 22px 24px 26px;
  }
  .card-meta {
    font-family: 'Satoshi', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    margin: 0 0 8px;
  }
  .card-title {
    font-family: 'Instrument Serif', serif;
    font-size: 24px;
    font-weight: 400;
    font-style: italic;
    color: #f5f2eb;
    line-height: 1.15;
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .card-location {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: rgba(255,255,255,0.3);
  }
  .card-arrow {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(255,255,255,0.09);
    border: 1px solid rgba(255,255,255,0.13);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .slide-item:hover .card-arrow {
    background: rgba(255,255,255,0.17);
  }
  .card-arrow svg {
    width: 12px; height: 12px;
    color: rgba(255,255,255,0.65);
  }

  /* ── EMPTY ── */
  .empty-state { padding: 80px 6vw; text-align: center; }
  .empty-title {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    font-style: italic;
    color: #9ca3af;
    margin: 0 0 8px;
  }
  .empty-text {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #d1d5db;
    margin: 0;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 640px) {
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .head-right { align-items: flex-start; }
    .section-subtitle { text-align: left; max-width: 100%; }
    .projects-section { padding: 64px 0 80px; }

    /* Cards slightly narrower so next card peeks */
    .slide-item { width: 76vw; height: 380px; }
  }
</style>

<section id="projects" class="projects-section">

  <div class="section-head">
    <div class="head-left">
      <p class="head-eyebrow">Portfolio</p>
      <h2 class="section-title">My Works</h2>
    </div>
    <div class="head-right">
      <p class="section-subtitle">Selected projects shaped by real constraints, and honest craft.</p>
      <div class="nav-arrows">
        <button id="prevBtn" class="nav-arrow" aria-label="Previous">
          <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
            <path d="M14 5.5H1M1 5.5L5.5 1M1 5.5L5.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button id="nextBtn" class="nav-arrow" aria-label="Next">
          <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
            <path d="M1 5.5H14M14 5.5L9.5 1M14 5.5L9.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {projects.length > 0 ? (
    <div class="slider-track" id="projectSlider">
      {projects.map((project) => (
        <a
          href={`/projects/${project.slug?.current || project._id}`}
          class="slide-item project-card-item"
        >
          {project.coverImage && (
            <img
              src={urlFor(project.coverImage).width(640).url()}
              alt={project.title}
              class="card-img-bg"
              loading="lazy"
            />
          )}
          <div class="card-vignette"></div>

          <div class="card-top">
            <span class="card-badge">{category || 'Project'}</span>
          </div>

          <div class="card-bottom">
            <p class="card-meta">
              {project.company && project.company.trim() !== '' ? project.company : 'Independent'}
            </p>
            <h3 class="card-title">{project.title}</h3>
            <div class="card-footer">
              <span class="card-location">{project.location || 'Remote'}</span>
              <div class="card-arrow">
                <svg viewBox="0 0 13 13" fill="none">
                  <path d="M2 11L11 2M11 2H4.5M11 2V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h3 class="empty-title">Nothing here yet.</h3>
      <p class="empty-text">Projects in this category will appear here.</p>
    </div>
  )}

</section>

<script>
  const initProjects = () => {
    const track   = document.getElementById('projectSlider') as HTMLElement | null;
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    if (track && prevBtn && nextBtn) {
      const cardWidth = 300 + 18;
      prevBtn.addEventListener('click', () => track.scrollBy({ left: -cardWidth, behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => track.scrollBy({ left: cardWidth, behavior: 'smooth' }));
    }
  };

  document.addEventListener('DOMContentLoaded', initProjects);
  document.addEventListener('astro:page-load', initProjects);
</script>