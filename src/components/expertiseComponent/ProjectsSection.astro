---
import { sanityClient } from 'sanity:client';
import imageUrlBuilder from '@sanity/image-url';

interface Props {
  category: string;
}

const { category } = Astro.props;

const builder = imageUrlBuilder(sanityClient);

function urlFor(source: any) {
  return builder.image(source);
}

const projects = await sanityClient.fetch(
  `*[_type == "project" && category == $category] | order(coalesce(featured, false) desc, _createdAt desc) {
    _id,
    title,
    company,
    location,
    coverImage,
    content,
    featured
  }`,
  { category }
);
---

<style>
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/Satoshi-Variable.woff2') format('woff2'),
         url('/fonts/Satoshi-Regular.woff2') format('woff2'),
         url('/fonts/Satoshi-Regular.woff') format('woff');
    font-weight: 300 900;
    font-display: swap;
    font-style: normal;
  }

  .projects-section {
    width: 100%;
    padding: 100px 0 120px;
  }

  /* ── HEADER ── */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    max-width: 1280px;
    margin: 0 auto 64px;
    padding: 0 6vw;
  }

  .head-eyebrow {
    font-family: 'Satoshi', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9ca3af;
    margin: 0 0 16px;
  }

  .section-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(48px, 5.5vw, 80px);
    font-weight: 400;
    font-style: italic;
    color: #0d0d0d;
    line-height: 1.0;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .head-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
    padding-bottom: 6px;
  }

  .section-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #6b7280;
    line-height: 1.7;
    max-width: 320px;
    text-align: right;
    margin: 0;
  }

  .nav-arrows {
    display: flex;
    gap: 10px;
  }

  .nav-arrow {
    background: none;
    border: 1px solid #d1d5db;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    color: #0d0d0d;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .nav-arrow:hover {
    background: #0d0d0d;
    border-color: #0d0d0d;
    color: #fff;
  }

  /* ── SLIDER ── */
  .slider-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px 6vw 40px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .slider-track::-webkit-scrollbar { display: none; }

  /* ── CARD ── */
  .slide-item {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: 320px;
    height: 500px;
    border-radius: 20px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: #111;
    /* Only translateY — cheap, compositor-only */
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.35s ease;
  }
  .slide-item:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }

  .card-img-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* scale on img itself — separate layer, no layout reflow */
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }
  .slide-item:hover .card-img-bg {
    transform: scale(1.04);
  }

  .card-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(5,5,5,0.92) 0%,
      rgba(5,5,5,0.35) 50%,
      rgba(5,5,5,0.08) 100%
    );
  }

  .card-top {
    position: absolute;
    top: 22px;
    left: 22px;
    z-index: 2;
  }

  .card-badge {
    font-family: 'Satoshi', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 5px 12px;
    border-radius: 100px;
  }

  .card-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 24px 26px 28px;
  }

  .card-meta {
    font-family: 'Satoshi', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.38);
    margin: 0 0 9px;
  }

  .card-title {
    font-family: 'Instrument Serif', serif;
    font-size: 27px;
    font-weight: 400;
    font-style: italic;
    color: #f5f2eb;
    line-height: 1.15;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-location {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.35);
  }

  /* Arrow icon — no rotation animation, just opacity */
  .card-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .slide-item:hover .card-arrow {
    background: rgba(255,255,255,0.18);
    border-color: rgba(255,255,255,0.25);
  }
  .card-arrow svg {
    width: 13px;
    height: 13px;
    color: rgba(255,255,255,0.7);
  }

  /* ── MODAL ── */
  .project-modal {
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 24px;
    background: transparent;
    width: 90vw;
    max-width: 1040px;
    max-height: 88vh;
    overflow: hidden;
  }

  .project-modal::backdrop {
    background: rgba(5, 5, 5, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .project-modal[open] {
    animation: modalIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.97) translateY(16px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  .modal-inner {
    display: flex;
    height: 88vh;
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
  }

  /* Left: image */
  .modal-img-panel {
    flex: 0 0 40%;
    position: relative;
    overflow: hidden;
    background: #111;
  }

  .modal-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
  }

  .modal-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5,5,5,0.5) 0%, transparent 50%);
  }

  .modal-img-caption {
    position: absolute;
    bottom: 28px;
    left: 28px;
    font-family: 'Satoshi', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
  }

  /* Right: content */
  .modal-content-panel {
    flex: 1;
    overflow-y: auto;
    padding: 48px 48px 48px 44px;
    scrollbar-width: thin;
    scrollbar-color: #e5e7eb transparent;
  }

  .modal-close-btn {
    position: sticky;
    top: 0;
    float: right;
    background: #f4f4f3;
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #6b7280;
    font-size: 15px;
    transition: background 0.15s ease, color 0.15s ease;
    z-index: 10;
    margin-bottom: 28px;
    line-height: 1;
  }
  .modal-close-btn:hover {
    background: #e5e7eb;
    color: #0d0d0d;
  }

  .modal-eyebrow {
    font-family: 'Satoshi', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9ca3af;
    margin: 0 0 14px;
    clear: both;
  }

  .modal-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(32px, 3vw, 48px);
    font-weight: 400;
    font-style: italic;
    color: #0d0d0d;
    line-height: 1.1;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }

  .modal-company {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #9ca3af;
    margin: 0 0 36px;
  }

  .modal-rule {
    width: 36px;
    height: 1px;
    background: #e5e7eb;
    margin: 0 0 36px;
  }

  .modal-text {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.85;
    color: #374151;
  }
  .modal-text p { margin: 0 0 20px; }
  .modal-text p:last-child { margin-bottom: 0; }

  /* ── EMPTY ── */
  .empty-state {
    padding: 80px 6vw;
    text-align: center;
  }
  .empty-title {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    font-style: italic;
    color: #9ca3af;
    margin: 0 0 8px;
  }
  .empty-text {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #d1d5db;
    margin: 0;
  }

  @media (max-width: 768px) {
    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .head-right { align-items: flex-start; }
    .section-subtitle { text-align: left; }
    .modal-inner { flex-direction: column; }
    .modal-img-panel { flex: 0 0 200px; }
    .modal-content-panel { padding: 28px 24px; }
  }
</style>

<section id="projects" class="projects-section">

  <div class="section-head">
    <div class="head-left">
      <p class="head-eyebrow">Portfolio</p>
      <h2 class="section-title">My Works</h2>
    </div>
    <div class="head-right">
      <p class="section-subtitle">Selected projects shaped by real constraints, real clients, and honest craft.</p>
      <div class="nav-arrows">
        <button id="prevBtn" class="nav-arrow" aria-label="Previous">
          <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
            <path d="M14 5.5H1M1 5.5L5.5 1M1 5.5L5.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button id="nextBtn" class="nav-arrow" aria-label="Next">
          <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
            <path d="M1 5.5H14M14 5.5L9.5 1M14 5.5L9.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {projects.length > 0 ? (
    <div class="slider-track" id="projectSlider">
      {projects.map((project) => (
        <>
          <div
            class="slide-item project-card-item"
            onclick={`document.getElementById('modal-${project._id}').showModal()`}
          >
            {project.coverImage && (
              <img
                src={urlFor(project.coverImage).width(640).url()}
                alt={project.title}
                class="card-img-bg"
                loading="lazy"
              />
            )}
            <div class="card-vignette"></div>

            <div class="card-top">
              <span class="card-badge">{category || 'Project'}</span>
            </div>

            <div class="card-bottom">
              <p class="card-meta">
                {project.company && project.company.trim() !== '' ? project.company : 'Independent'}
              </p>
              <h3 class="card-title">{project.title}</h3>
              <div class="card-footer">
                <span class="card-location">{project.location || 'Remote'}</span>
                <div class="card-arrow">
                  <svg viewBox="0 0 13 13" fill="none">
                    <path d="M2 11L11 2M11 2H4.5M11 2V8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <dialog id={`modal-${project._id}`} class="project-modal">
            <div class="modal-inner">

              <div class="modal-img-panel">
                {project.coverImage && (
                  <img
                    src={urlFor(project.coverImage).width(800).url()}
                    alt={project.title}
                    class="modal-img"
                    loading="lazy"
                  />
                )}
                <div class="modal-img-overlay"></div>
                <p class="modal-img-caption">{category}</p>
              </div>

              <div class="modal-content-panel">
                <button
                  class="modal-close-btn"
                  onclick={`document.getElementById('modal-${project._id}').close()`}
                  aria-label="Close"
                >✕</button>

                <p class="modal-eyebrow">{project.location || 'Remote'}</p>
                <h3 class="modal-title">{project.title}</h3>
                <p class="modal-company">
                  {project.company && project.company.trim() !== '' ? project.company : 'Independent project'}
                </p>

                <div class="modal-rule"></div>

                <div class="modal-text">
                  {project.content
                    ? project.content.map((block: any) =>
                        block._type === 'block'
                          ? <p>{block.children?.map((child: any) => child.text).join('')}</p>
                          : null
                      )
                    : <p>No description available for this project.</p>
                  }
                </div>
              </div>
            </div>
          </dialog>
        </>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <h3 class="empty-title">Nothing here yet.</h3>
      <p class="empty-text">Projects in this category will appear here.</p>
    </div>
  )}

</section>

<script>
  const initProjects = () => {
    const track = document.getElementById('projectSlider') as HTMLElement | null;
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    if (track && prevBtn && nextBtn) {
      const cardWidth = 320 + 18;
      prevBtn.addEventListener('click', () => track.scrollBy({ left: -cardWidth, behavior: 'smooth' }));
      nextBtn.addEventListener('click', () => track.scrollBy({ left: cardWidth, behavior: 'smooth' }));
    }

    document.querySelectorAll<HTMLDialogElement>('.project-modal').forEach(dialog => {
      dialog.addEventListener('click', (e: MouseEvent) => {
        const r = dialog.getBoundingClientRect();
        if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
          dialog.close();
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initProjects);
  document.addEventListener('astro:page-load', initProjects);
</script>