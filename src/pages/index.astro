---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/Preloader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Navbar from '../components/Navbar.astro';
import BentoGrid from '../components/BentoGrid.astro';
import CTO from '../components/CTO.astro';
import Footer from '../components/Footer.astro';

---

<script is:inline>
      const urlParams = new URLSearchParams(window.location.search);
      const lastPage = sessionStorage.getItem('last_competency_page');
      
      // 1. Mantra bypass buat lu pas testing/kerja di web live
      if (urlParams.get('owner') === 'rafi') {
        sessionStorage.removeItem('last_competency_page');
      } 
      // 2. Skrip pengunci (Hanya aktif di server live, di localhost lu tetep bebas bergerak)
      else if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
        if (lastPage) {
          window.location.href = lastPage;
        }
      }
    </script>

<BaseLayout title="Home | Muhammad Rafi Mahdy">
  <Hero />
  <About />
  <main class="max-w-6xl mx-auto px-6 py-12 md:py-20">
    <BentoGrid />
  </main>
	<Navbar />
	<CTO />
  <Footer />
</BaseLayout>
