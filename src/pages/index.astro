---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/Preloader.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Navbar from '../components/Navbar.astro';
import BentoGrid from '../components/BentoGrid.astro';
import CTO from '../components/CTO.astro';
import Footer from '../components/Footer.astro';

---

<Fragment slot="head">
  <script is:inline>
  const urlParams = new URLSearchParams(window.location.search);
  const lastPage = sessionStorage.getItem('last_competency_page');
  
  // 1. Mantra bypass buat lu sendiri
  if (urlParams.get('owner') === 'rafi') {
    sessionStorage.removeItem('last_competency_page');
  } 
  // 2. Kunci hanya berjalan di server live
  else if (window.location.hostname !== 'localhost' && window.location.hostname !== '127.0.0.1') {
    
    if (lastPage) {
      // KUNCI UTAMA: Cek dari mana user ini berasal
      const referredFrom = document.referrer;
      
      // Jika user datang ke home BUKAN karena ngeklik link/tombol dari dalam web lu sendiri,
      // alias nilainya kosong (ketik manual di URL bar) atau datang dari luar domain mrafimahdy.works
      if (!referredFrom || !referredFrom.includes(window.location.hostname)) {
        window.location.href = lastPage;
      } else {
        // Kalau mereka datang karena klik tombol "Back" atau menu internal, 
        // kita bersihkan memorinya agar mereka bisa liat homepage dengan normal lagi!
        sessionStorage.removeItem('last_competency_page');
      }
    }

  }
</script>
</Fragment>

<BaseLayout title="Home | Muhammad Rafi Mahdy">
  <Hero />
  <About />
  <main class="max-w-6xl mx-auto px-6 py-12 md:py-20">
    <BentoGrid />
  </main>
	<Navbar />
	<CTO />
  <Footer />
</BaseLayout>
