---
// src/layouts/BaseLayout.astro

import CustomCursor from '../components/CustomCursor.astro';
import Preloader from '../components/Preloader.astro'; // <-- Import Preloader di sini
const { title = "Rafi Portfolio" } = Astro.props;
---

<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Rafi</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <style is:inline>
      /* BASE RESET */
      body {
        background-color: #f9fbfd;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        position: relative;
      }

      .sophie-grain-layer {
        position: fixed;
        inset: 0;
        z-index: -9;
        opacity: 0.025;
        pointer-events: none;
        contain: paint;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      }

      section, main {
        background-color: transparent !important;
      }

      /* Efek transisi smooth buat ngilangin edge pas masuk footer */
      .edge-blur {
        position: fixed;
        pointer-events: none;
        z-index: 30;
        contain: paint;
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* KUNCI: Saat body punya class 'is-in-footer', kiri, kanan, bawah hilang! */
      body.is-in-footer .edge-bottom,
      body.is-in-footer .edge-left,
      body.is-in-footer .edge-right {
        opacity: 0;
      }

      .edge-top {
        top: 0; left: 0; right: 0; height: 96px;
        background: linear-gradient(to bottom, rgba(249,251,253,0.92), rgba(249,251,253,0));
      }
      .edge-bottom {
        bottom: 0; left: 0; right: 0; height: 96px;
        background: linear-gradient(to top, rgba(249,251,253,0.88), rgba(249,251,253,0));
      }
      .edge-left {
        top: 0; bottom: 0; left: 0; width: 44px;
        background: linear-gradient(to right, rgba(249,251,253,0.72), rgba(249,251,253,0));
      }
      .edge-right {
        top: 0; bottom: 0; right: 0; width: 44px;
        background: linear-gradient(to left, rgba(249,251,253,0.72), rgba(249,251,253,0));
      }
    </style>

    <slot name="head" />
  </head>
  <body class="font-sans antialiased">
    
    <Preloader />

    <div class="edge-blur edge-top"></div>
    <div class="edge-blur edge-bottom"></div>
    <div class="edge-blur edge-left"></div>
    <div class="edge-blur edge-right"></div>

    <div class="fixed inset-0 z-[-10] pointer-events-none" aria-hidden="true">
      <div class="w-full h-full bg-gradient-to-br from-indigo-50/30 via-slate-50 to-blue-50/20"></div>
    </div>

    <div class="sophie-grain-layer"></div>

    <div class="relative z-[9999]">
      <CustomCursor />
    </div>

    <main class="relative w-full px-10 py-10"> 
      <slot />
    </main>

    <slot name="scripts" />

    <script>
      window.addEventListener('DOMContentLoaded', () => {
        // Logika Deteksi Footer (Observer)
        const footerElement = document.querySelector('footer');
        if (footerElement) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              // Jika 15% dari footer mulai terlihat di layar
              if (entry.isIntersecting) {
                document.body.classList.add('is-in-footer');
              } else {
                document.body.classList.remove('is-in-footer');
              }
            });
          }, { 
            root: null, 
            threshold: 0.15 // Aktif saat 15% area footer masuk viewport
          });
          
          observer.observe(footerElement);
        }
      });
    </script>
  </body>
</html>