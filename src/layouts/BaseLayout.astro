---
// src/layouts/BaseLayout.astro
import CustomCursor from '../components/CustomCursor.astro';
import Preloader from '../components/Preloader.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import '../styles/global.css';

const { 
  title = "Rafi Portfolio", 
  description = "Portofolio profesional Muhammad Rafi Mahdy - Specialist dalam Berbagai Bidang." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Rafi</title>
    <meta name="description" content={description} />

    <script is:inline>
      (function () {
        var KEY = 'rafi-entry-v1';

        // Halaman yang tetap bisa diakses dari entry manapun.
        // Tambah path di sini kalau perlu, misal '/contact'.
        var ALWAYS_FREE = [];

        try {
          var entry       = sessionStorage.getItem(KEY);
          var currentPath = window.location.pathname;

          if (entry && entry !== '/') {
            // Pengunjung masuk lewat position page.
            // Hanya boleh di path entry mereka atau di ALWAYS_FREE.
            var isOnEntry = currentPath === entry;
            var isFree    = ALWAYS_FREE.indexOf(currentPath) !== -1;

            if (!isOnEntry && !isFree) {
              document.documentElement.style.visibility = 'hidden';
              window.location.replace(entry);
            }
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  
  <body class="font-sans antialiased">

    <script is:inline>
      (function () {
        var KEY = 'rafi-entry-v1';
        try {
          if (!sessionStorage.getItem(KEY)) {
            sessionStorage.setItem(KEY, window.location.pathname);
          }
          document.documentElement.style.visibility = '';
        } catch (e) {}
      })();
    </script>

    <Preloader />

    <div class="edge-blur edge-top"></div>
    <div class="edge-blur edge-bottom"></div>
    <div class="edge-blur edge-left"></div>
    <div class="edge-blur edge-right"></div>

    <div class="fixed inset-0 z-[-10] pointer-events-none" aria-hidden="true">
      <div class="w-full h-full bg-gradient-to-br from-indigo-50/30 via-slate-50 to-blue-50/20"></div>
    </div>

    <div class="sophie-grain-layer"></div>

    <div class="relative z-[9999]">
      <CustomCursor />
    </div>

    <main class="relative w-full px-10 py-10"> 
      <slot />
    </main>

    <slot name="scripts" />

    <script>
      window.addEventListener('DOMContentLoaded', () => {
        const footerElement = document.querySelector('footer');
        if (footerElement) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                document.body.classList.add('is-in-footer');
              } else {
                document.body.classList.remove('is-in-footer');
              }
            });
          }, { root: null, threshold: 0.15 });
          observer.observe(footerElement);
        }
      });

      // Guard untuk Astro View Transitions (navigasi tanpa full reload)
      document.addEventListener('astro:page-load', () => {
        const KEY         = 'rafi-entry-v1';
        const ALWAYS_FREE: string[] = []; // samain dengan yang di <head>

        try {
          const entry       = sessionStorage.getItem(KEY);
          const currentPath = window.location.pathname;

          if (entry && entry !== '/') {
            const isOnEntry = currentPath === entry;
            const isFree    = ALWAYS_FREE.includes(currentPath);

            if (!isOnEntry && !isFree) {
              window.location.replace(entry);
            }
          }
        } catch (e) {}
      });
    </script>

    <Analytics />
    <SpeedInsights />
  </body>
</html>